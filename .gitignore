# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/

# environment
.env

# review run workspaces created by slr.py (real user data -- keep out of the repo)
runs/
runs_web/
server.log

# A real run writes output/ and pdfs/ into the working directory -- keep them out
# of git. The committed demonstration run lives under examples/demo_output/ and
# examples/demo_pdfs/ instead.
output/
pdfs/

# Playwright MCP tool session artifacts (console logs, page snapshots) -- not
# project source.
.playwright-mcp/

# Worktrees for isolated development
.worktrees/

# Scratch testbed for reproducing bugs against a pipx-style install -- not
# project source, never committed.
_testbed/

# Temporary test / inspection artifacts
*.log
*.html
!web/*.html
api_test*.json
auth_state.json
call_create_project.json
check_*.json
click_*.json
