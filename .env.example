# Copy this file to .env and fill in real values.
# search.py / download.py / verify_citations.py read MAILTO / S2_API_KEY from the
# environment as a fallback if the corresponding --mailto / --s2-api-key flag is omitted.

# Polite-pool contact email for OpenAlex, Crossref, and Unpaywall. Required by
# OpenAlex and Crossref for reliable rate limits, and required outright by Unpaywall.
MAILTO=you@example.com

# Optional Semantic Scholar API key for a higher rate limit than the shared
# keyless pool (~100 req/5 min). Request one at https://www.semanticscholar.org/product/api
S2_API_KEY=

# Optional CORE API key -- enables CORE (https://core.ac.uk) as an extra open-access
# source in download.py. Leave blank to skip CORE. Request a key at https://core.ac.uk/services/api
CORE_API_KEY=
