# Copy this file to .env and fill in real values.
#
# slr.py, search.py and download.py load this file automatically at startup.
# Precedence, highest first:  command-line flag  >  exported env var  >  .env
# So a flag always wins over this file, and this file never overrides a variable
# you exported deliberately for one run.
#
# .env IS THE DURABLE HOME FOR YOUR KEYS. The guided TUI (slr.py) will prompt for
# keys and use them for that session, but it never writes them into the run folder
# (runs/<id>/config.json holds no credentials -- that folder is meant to be shared
# with co-authors and attached as a reproducibility appendix). A key typed at the
# prompt is forgotten when the session ends; a key in .env survives a resume.
# .env is gitignored.
#
# EVERY API KEY HERE IS OPTIONAL. Leave any of them blank.
#   - openalex, crossref, arxiv, doaj      work with no key at all.
#   - semanticscholar and pubmed           work with no key, but a key raises the rate limit.
#   - ieee, scopus, springer, core, wos    need a key; without one the source is simply
#                                          skipped with a note, never an error.

# Polite-pool contact email for OpenAlex, Crossref, and Unpaywall. Required by
# OpenAlex and Crossref for reliable rate limits, required outright by Unpaywall,
# and required by NCBI on every PubMed E-utilities call. This one is NOT optional.
MAILTO=you@example.com

# --- Keys that raise a rate limit (the source still works without them) ---

# Semantic Scholar. Keyless runs share a low anonymous pool (~100 req/5 min across
# ALL unauthenticated users). A key gives you 1 request/second of your own.
# https://www.semanticscholar.org/product/api
S2_API_KEY=

# NCBI / PubMed. Keyless is 3 requests/second per IP; a key raises it to 10/sec.
# Free, self-service, tied to an NCBI account. https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=

# --- Keys that unlock a source (blank = that source is skipped) ---

# CORE (https://core.ac.uk). Enables CORE both as a search source in search.py and
# as an extra open-access PDF source in download.py. Free self-signup; a personal
# key gives 1,000 tokens/day at 25 req/min, an academic key 5,000/day at 10 req/min
# (if your key is academic, pass --core-min-interval 6.0 to search.py).
# https://core.ac.uk/services/api
CORE_API_KEY=

# IEEE Xplore. Requires an active IEEE institutional subscription -- individual
# researchers without one are generally not granted a key. Rate limits are shown to
# you at registration (10 calls/second, 200 calls/day) rather than published.
# https://developer.ieee.org
IEEE_API_KEY=

# Scopus (Elsevier). Requires an institutional subscription. The key is authenticated
# by your institution's IP range, so it only works ON CAMPUS by default.
# https://dev.elsevier.com
SCOPUS_API_KEY=

# Scopus institutional token. Only needed to use SCOPUS_API_KEY OFF campus -- it
# substitutes for IP authentication. Elsevier support must enable it for your account.
# Treat it as a full-access credential: server-side only, never commit it.
SCOPUS_INSTTOKEN=

# Springer Nature. Free self-signup, no institution needed. The free Basic tier is
# 100 requests/minute, 500 requests/day, 25 records per request. Register for the
# Meta API (not the Open Access API) -- Meta covers all content regardless of
# access status; Open Access only covers Springer's OA-published subset, which
# would silently miss every paywalled Springer paper in your search.
# https://dev.springernature.com
SPRINGER_API_KEY=

# Web of Science Expanded (Clarivate). Requires an institutional subscription --
# individual researchers without one are generally not granted a key. Rate limit
# is plan-dependent: 2/3/5 requests/second on Basic/Advanced/Premium, plus an
# annual full-record quota (e.g. 50,000/year on Basic).
# https://developer.clarivate.com/apis/wos
WOS_API_KEY=
